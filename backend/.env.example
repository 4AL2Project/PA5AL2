DATABASE_URL="postgresql://pharma:pharma@localhost:5432/pharma_risk"
PORT=3005
NODE_ENV=development
JWT_ACCESS_SECRET=example-access
JWT_REFRESH_SECRET=example-refresh-access
REDIS_URL=redis://localhost:6379
RESEND_API_KEY=re_api-key

# Email transport: 'resend' (prod) ou 'smtp' (dev/test via MailHog)
EMAIL_TRANSPORT=smtp
EMAIL_FROM=noreply@savely.fr
SMTP_HOST=localhost
SMTP_PORT=1025

# ─── Stockage des fichiers (images d'offres, logos d'assos, imports) ──────────
# STORAGE_DRIVER: 's3' (AWS S3 + CloudFront) ou 'local' (disque, dev/test).
# Laissé vide, bascule sur 's3' si AWS_S3_BUCKET est défini, sinon 'local'.
STORAGE_DRIVER=local
# Bucket S3 et région (obligatoires en mode s3)
AWS_S3_BUCKET=
AWS_REGION=eu-west-3
# Credentials IAM (optionnels : sinon la chaîne AWS par défaut est utilisée —
# rôle IAM, profil, variables d'environnement AWS_*, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Domaine CloudFront servant le bucket (sans slash final)
CLOUDFRONT_URL=
# Optionnel — endpoint S3 compatible custom (MinIO / LocalStack) + path-style
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
