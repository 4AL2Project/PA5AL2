# ─── PostgreSQL (service `postgres`) ──────────────────────────────
# Identifiants de la base de données. Valeurs par défaut prêtes à l'emploi.
POSTGRES_USER=pharma
POSTGRES_PASSWORD=pharma
POSTGRES_DB=pharma_risk

# ─── Backend NestJS (service `backend`) ───────────────────────────
# Port exposé par l'API.
BACKEND_PORT=3005
# Connexion Prisma. Le hostname `postgres` correspond au nom du service Compose.
DATABASE_URL=postgresql://pharma:pharma@postgres:5432/pharma_risk
# Secrets JWT (US-03). À remplacer en production.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# ─── Frontend Next.js (service `frontend`) ────────────────────────
# URL de l'API joignable depuis le navigateur (côté client).
NEXT_PUBLIC_API_URL=http://localhost:3005
# Pharmacie de démonstration créée par le seed.
NEXT_PUBLIC_PHARMACY_ID=3c865b32-ba84-483d-8256-2b1d7d5e542e
