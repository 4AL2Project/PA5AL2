generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pharmacy {
  pharmacy_id       String    @id @default(uuid())
  name              String
  email             String    @unique
  address           String?
  siret             String?
  status            String    @default("ACTIVE")
  lat               Float?
  lng               Float?
  // Créneaux hebdo de récupération des dons, ex [{"day":"TUE","start":"14:00","end":"17:00"}]
  donation_pickup_windows Json?
  created_at        DateTime  @default(now())
  last_upload_at    DateTime?
  subscription_tier String    @default("free")

  products          Product[]
  sales             Sale[]
  analyses          RiskAnalysis[]
  users             User[]
  actions           Action[]
  donations         Donation[]
  imports           Import[]
  offers            Offer[]
  orders            Order[]
  categories        Category[]
  don_parametres    DonParametres?
}

// Catégorie de classement d'une Offer B2C (référentiel exposé au catalogue mobile).
// Portée : `pharmacy_id = null` → catégorie système partagée (les 6 par défaut,
// dont "Autres" utilisée comme repli). Sinon → catégorie propre à une pharmacie.
model Category {
  category_id String   @id @default(uuid())
  pharmacy_id String?
  name        String
  slug        String
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  pharmacy    Pharmacy? @relation(fields: [pharmacy_id], references: [pharmacy_id])
  offers      Offer[]   @relation("OfferCategories")

  @@unique([pharmacy_id, slug])
  @@index([pharmacy_id])
}

model User {
  user_id           String    @id @default(uuid())
  // null quand role = ADMIN_SAVELY (pas d'officine rattachée)
  pharmacy_id       String?
  email             String    @unique
  // null pour les PREPARATEUR : ils se connectent par code OTP, jamais par mot de passe
  password          String?
  role              String    @default("TITULAIRE")
  status            String    @default("ACTIVE")
  first_name        String?
  last_name         String?
  phone             String?
  accepted_terms_at DateTime?
  created_at        DateTime  @default(now())

  pharmacy    Pharmacy?   @relation(fields: [pharmacy_id], references: [pharmacy_id])
  auth_tokens AuthToken[]
  otps        UserOtp[]
  order_activities OrderActivity[]
  notifications    Notification[]
}

model AuthToken {
  id          String    @id @default(uuid())
  user_id     String
  token_hash  String    @unique
  type        String
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [user_id])

  @@index([token_hash])
}

// Code OTP de connexion d'un utilisateur back-office (préparateur).
// Rattaché au User : contrairement au Customer B2C, le compte existe toujours
// en amont (créé par invitation du titulaire).
model UserOtp {
  otp_id      String    @id @default(uuid())
  user_id     String
  code_hash   String
  expires_at  DateTime
  attempts    Int       @default(0)
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [user_id])

  @@index([user_id, created_at])
}

model Product {
  product_id     String   @id @default(uuid())
  pharmacy_id    String
  external_sku   String
  lot_number     String?
  name           String
  category       String?
  brand          String?
  expiry_date    DateTime?
  stock_quantity Int
  unit_price     Float
  cost_price     Float?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  pharmacy       Pharmacy      @relation(fields: [pharmacy_id], references: [pharmacy_id])
  sales          Sale[]
  analyses       RiskAnalysis[]
  action         Action?
  donation_lines DonationLine[]
  offer          Offer?

  @@unique([pharmacy_id, external_sku])
  @@index([pharmacy_id, expiry_date])
}

model Sale {
  sale_id         String   @id @default(uuid())
  product_id      String
  pharmacy_id     String
  sale_date       DateTime
  quantity_sold   Int
  unit_price_sold Float?
  created_at      DateTime @default(now())

  product         Product  @relation(fields: [product_id], references: [product_id])
  pharmacy        Pharmacy @relation(fields: [pharmacy_id], references: [pharmacy_id])

  @@unique([product_id, sale_date, quantity_sold])
  @@index([product_id, sale_date])
}

model RiskAnalysis {
  analysis_id        String   @id @default(uuid())
  product_id         String
  pharmacy_id        String
  analysis_date      DateTime @default(now())

  days_of_cover      Float
  sales_velocity_30d Float
  capital_locked     Float
  risk_level         String
  suggested_action   String
  recoverable_value  Float
  potential_loss     Float

  product            Product  @relation(fields: [product_id], references: [product_id])
  pharmacy           Pharmacy @relation(fields: [pharmacy_id], references: [pharmacy_id])

  @@unique([product_id, analysis_date])
}

// Centre d'actions : une action de remédiation par produit dormant
model Action {
  action_id         String    @id @default(uuid())
  product_id        String    @unique
  pharmacy_id       String
  type              String    // 'B2C' | 'DON'
  status            String    @default("EN_ATTENTE") // EN_ATTENTE|VALIDEE|IGNOREE|SNOOZEE
  snooze_until      DateTime?
  days_of_cover     Float
  capital_locked    Float
  recoverable_value Float
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  product           Product   @relation(fields: [product_id], references: [product_id])
  pharmacy          Pharmacy  @relation(fields: [pharmacy_id], references: [pharmacy_id])
  donations         Donation[]
  offer             Offer?

  @@index([pharmacy_id, status])
}

// Associations bénéficiaires de dons médicamenteux.
// L'adresse est celle du SIÈGE (domiciliation) ; la zone d'action réelle est
// action_radius_km autour du siège — c'est ce rayon (propre à l'asso, plafonné
// à 100 km) qui pilote l'éligibilité au matching, jamais un rayon fixe Savely.
// V2 (hors scope) : zones d'action multiples par départements.
// categories : catégories produits acceptées. Product.category est une chaîne
// libre issue des exports LGO (pas de table Category produit), donc String[]
// et non une relation M2M.
model Association {
  association_id  String    @id @default(uuid())
  name            String
  address         String
  city            String
  postal_code     String
  lat             Float?
  lng             Float?
  action_radius_km Int      @default(30)
  categories      String[]
  pickup_sla_days Int       @default(7)
  response_sla_hours Int    @default(72)
  rna_or_siren    String?
  contact_email   String?
  contact_phone   String?
  logo_url        String?
  // ACTIVE | EN_ATTENTE_VALIDATION | REJETEE | SUSPENDUE | BLACKLISTEE
  status          String    @default("ACTIVE")
  rejection_reason String?
  // Agrément préfectoral / habilitation ouvrant droit au reçu fiscal (Cerfa)
  agrement_numero  String?
  agrement_valide  Boolean   @default(false)
  // Horodatage de mise en liste noire (BLACKLISTEE, uniquement depuis SUSPENDUE)
  blacklisted_at   DateTime?
  // Éligibilité au reçu fiscal vérifiée par l'admin (art. 200/238 bis CGI)
  fiscal_receipt_verified Boolean @default(false)
  email_verified_at DateTime?
  verify_token_hash String? @unique
  verify_token_expires_at DateTime?
  // Créneaux hebdo de passage déclarés par l'asso (V1 statiques), affichés
  // dans l'annuaire et intersectés avec les fenêtres de l'officine au moment
  // de proposer les créneaux de retrait. Ex [{"day":"MON","start":"09:00","end":"17:00"}]
  pickup_windows  Json?
  // Dénormalisé depuis DonationProposal.sent_at : sert au score d'équité du
  // matching sans requête d'agrégation à chaque classement
  last_proposal_at DateTime?
  created_at      DateTime  @default(now())
  // Espace association : magic link de connexion
  magic_link_token_hash  String?   @unique
  magic_link_expires_at  DateTime?
  // true après le premier passage dans PUT /asso/me (onboarding complété)
  is_onboarded           Boolean   @default(false)
  description            String?
  site_web               String?

  proposals       DonationProposal[]
  allocations     DonationAllocation[]
  notes           AssociationNote[]
  logs            AssociationLog[]
}

// Note interne rédigée par un admin Savely sur une association (back-office).
model AssociationNote {
  note_id        String      @id @default(uuid())
  association_id String
  admin_email    String
  contenu        String
  created_at     DateTime    @default(now())

  association    Association @relation(fields: [association_id], references: [association_id], onDelete: Cascade)

  @@index([association_id, created_at(sort: Desc)])
}

// Journal d'audit des actions admin sur une association (back-office).
// action : CREATED | INVITED | STATUS_CHANGED | NOTE_ADDED | UPDATED | ONBOARDED …
model AssociationLog {
  log_id         String      @id @default(uuid())
  association_id String
  admin_email    String?
  action         String
  details        String?
  created_at     DateTime    @default(now())

  association    Association @relation(fields: [association_id], references: [association_id], onDelete: Cascade)

  @@index([association_id, created_at(sort: Desc)])
}

// Don = LOT multi-produits piloté par l'orchestrateur.
// Machine à états : EN_COURS → COMPLETEE | ECHOUEE | ANNULEE.
// version : optimistic locking sur les transitions concurrentes (réponse asso
// vs annulation titulaire vs cron d'expiration).
model Donation {
  donation_id   String    @id @default(uuid())
  pharmacy_id   String
  action_id     String?
  status        String    @default("EN_COURS") // EN_COURS|COMPLETEE|ECHOUEE|ANNULEE
  attempt_count Int       @default(0)
  version       Int       @default(0)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  pharmacy      Pharmacy  @relation(fields: [pharmacy_id], references: [pharmacy_id])
  action        Action?   @relation(fields: [action_id], references: [action_id])
  lines         DonationLine[]
  proposals     DonationProposal[]
  allocations   DonationAllocation[]
  events        DonationEvent[]

  @@index([pharmacy_id, status])
}

// Ligne du lot : quantité totale donnée et quantité déjà allouée (acceptée).
// unit_value fige la valeur au moment du don — base du Cerfa.
// Invariant vérifié en base : quantity_allocated <= quantity_total (contrainte
// CHECK ajoutée par migration SQL).
model DonationLine {
  line_id            String  @id @default(uuid())
  donation_id        String
  product_id         String
  quantity_total     Int
  quantity_allocated Int     @default(0)
  unit_value         Float

  donation           Donation @relation(fields: [donation_id], references: [donation_id], onDelete: Cascade)
  product            Product  @relation(fields: [product_id], references: [product_id])

  @@unique([donation_id, product_id])
}

// Proposition du reliquat du lot à UNE asso (cascade : jamais de broadcast).
// token : lien public à usage unique /don/:token — l'asso n'a pas de compte.
// proposed_lines : snapshot [{product_id, name, quantity, unit_value}] des
// quantités proposées à CET envoi.
model DonationProposal {
  proposal_id    String    @id @default(uuid())
  donation_id    String
  association_id String
  token          String    @unique @default(uuid())
  // ENVOYEE|ACCEPTEE|ACCEPTEE_PARTIELLEMENT|REFUSEE|EXPIREE|SUPERSEDED
  status         String    @default("ENVOYEE")
  refusal_reason String?
  proposed_lines Json
  sent_at        DateTime  @default(now())
  responded_at   DateTime?
  expires_at     DateTime

  donation       Donation    @relation(fields: [donation_id], references: [donation_id], onDelete: Cascade)
  association    Association @relation(fields: [association_id], references: [association_id])
  allocation     DonationAllocation?

  @@index([status, expires_at])
  @@index([donation_id])
}

// Ce qu'une asso a accepté et vient chercher à l'officine sur un créneau.
// PLANIFIEE → RETIREE (Cerfa généré sur les lignes de CETTE allocation)
//           → NON_RECUPEREE (créneau + 24h sans confirmation)
model DonationAllocation {
  allocation_id     String    @id @default(uuid())
  donation_id       String
  association_id    String
  proposal_id       String    @unique
  // [{product_id, name, quantity, unit_value}]
  lines             Json
  status            String    @default("PLANIFIEE") // PLANIFIEE|RETIREE|NON_RECUPEREE
  // QR présenté par l'asso au retrait, scanné par le préparateur (app
  // Flutter) pour confirmer le pickup — le web reste un fallback titulaire
  qr_code           String    @unique @default(uuid())
  pickup_slot_start DateTime
  pickup_slot_end   DateTime
  picked_up_by      String?
  picked_up_at      DateTime?
  cerfa_number      String?
  cerfa_url         String?   // URL S3/CloudFront du PDF Cerfa généré
  qr_code_url       String?   // URL S3/CloudFront de l'image QR code

  donation          Donation    @relation(fields: [donation_id], references: [donation_id], onDelete: Cascade)
  association       Association @relation(fields: [association_id], references: [association_id])
  proposal          DonationProposal @relation(fields: [proposal_id], references: [proposal_id])

  @@index([association_id, status])
  @@index([status, pickup_slot_end])
}

// Audit trail du don : toute transition est horodatée et journalisée
// (le Cerfa engage fiscalement le pharmacien).
// actor : 'SYSTEM' | 'TITULAIRE:<user_id>' | 'PREPARATEUR:<user_id>' | 'ASSOCIATION:<association_id>'
model DonationEvent {
  event_id    String   @id @default(uuid())
  donation_id String
  type        String
  actor       String
  payload     Json?
  created_at  DateTime @default(now())

  donation    Donation @relation(fields: [donation_id], references: [donation_id], onDelete: Cascade)

  @@index([donation_id, created_at])
}

// Trace d'envoi email du cycle don : garantit l'idempotence des relances
// (le cron ne renvoie jamais deux fois le même type d'email pour la même cible).
model DonationEmailLog {
  id            String   @id @default(uuid())
  proposal_id   String?
  allocation_id String?
  email_type    String
  sent_at       DateTime @default(now())

  @@unique([proposal_id, email_type])
  @@unique([allocation_id, email_type])
}

// Trace métier persistante de chaque dépôt de fichier (≠ Job BullMQ éphémère)
model Import {
  import_id   String   @id @default(uuid())
  pharmacy_id String
  file_name   String
  file_type   String   // 'products' | 'sales'
  uploaded_at DateTime @default(now())
  status      String   @default("EN_ATTENTE") // EN_ATTENTE|EN_COURS|TERMINÉ|ÉCHOUÉ
  rows_total  Int?
  rows_ok     Int?
  rows_failed Int?
  errors      Json?

  // URLs d'archivage S3/CloudFront des fichiers importés (null si absent ou
  // en mode stockage local sans upload). Un import peut porter les deux.
  products_file_url String?
  sales_file_url    String?

  pharmacy    Pharmacy @relation(fields: [pharmacy_id], references: [pharmacy_id])

  @@index([pharmacy_id, uploaded_at])
}

// Compte léger d'un acheteur B2C (app mobile)
// password optionnel : la connexion mobile se fait par code OTP (voir CustomerOtp)
// civility : 'MR' | 'MME'. Pas d'adresse stockée (RGPD) : la position vient de
// la géolocalisation du device au moment de la requête (ex. GET /offers/nearby).
model Customer {
  customer_id String   @id @default(uuid())
  email       String   @unique
  password    String?
  civility    String?
  first_name  String?
  last_name   String?
  phone       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  orders        Order[]
  notifications Notification[]
}

// Code OTP à usage unique pour la connexion Customer B2C (app mobile).
// Le code (6 chiffres) n'est jamais stocké en clair : seul son hash SHA-256 l'est.
// Indexé par email car le compte Customer peut ne pas encore exister au moment
// de la demande de code (création à la vérification).
model CustomerOtp {
  otp_id      String    @id @default(uuid())
  email       String
  code_hash   String
  expires_at  DateTime
  attempts    Int       @default(0)
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  @@index([email, created_at])
}

// Offre B2C publiée par le Titulaire sur un produit dormant
// Un seul produit = une seule Offer active à la fois
model Offer {
  offer_id         String    @id @default(uuid())
  pharmacy_id      String
  product_id       String    @unique
  action_id        String?   @unique
  description      String?
  discounted_price Float
  quantity_offered Int
  status           String    @default("ACTIVE") // ACTIVE|SUSPENDUE|TERMINEE
  expires_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  pharmacy         Pharmacy  @relation(fields: [pharmacy_id], references: [pharmacy_id])
  product          Product   @relation(fields: [product_id], references: [product_id])
  action           Action?   @relation(fields: [action_id], references: [action_id])
  orderLines       OrderLine[]
  images           OfferImage[]
  categories       Category[] @relation("OfferCategories")

  @@index([pharmacy_id, status])
}

// Image produit rattachée à une Offer (galerie, ordonnée par position)
model OfferImage {
  image_id   String   @id @default(uuid())
  offer_id   String
  url        String
  position   Int      @default(0)
  created_at DateTime @default(now())

  offer      Offer    @relation(fields: [offer_id], references: [offer_id], onDelete: Cascade)

  @@index([offer_id])
}

// Réservation d'un panier (une pharmacie par panier) par un Customer
// Machine à états : RESERVEE→EN_PREPARATION→PRETE→RETIREE|ANNULEE|EXPIREE
// Un seul QR pour tout le panier — les OrderLine avancent ensemble.
model Order {
  order_id     String    @id @default(uuid())
  customer_id  String
  pharmacy_id  String
  status       String    @default("RESERVEE")
  qr_code      String    @unique @default(uuid())
  expires_at   DateTime  // reserved_at + 24h
  reserved_at  DateTime  @default(now())
  prepared_at  DateTime?
  ready_at     DateTime?
  withdrawn_at DateTime?
  cancelled_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  customer     Customer  @relation(fields: [customer_id], references: [customer_id])
  pharmacy     Pharmacy  @relation(fields: [pharmacy_id], references: [pharmacy_id])
  lines        OrderLine[]
  activities   OrderActivity[]

  @@index([pharmacy_id, status])
  @@index([expires_at, status])
}

// Ligne d'un panier : une Offer réservée avec sa quantité. unit_price_snapshot
// fige le prix affiché à la réservation (indicatif — le règlement se fait en
// officine, ce n'est pas une transaction de paiement).
model OrderLine {
  order_line_id       String @id @default(uuid())
  order_id            String
  offer_id            String
  quantity            Int
  unit_price_snapshot Float

  order               Order  @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  offer               Offer  @relation(fields: [offer_id], references: [offer_id])

  @@index([order_id])
  @@index([offer_id])
}

// Historique des transitions d'un Order : qui a fait quoi et quand.
// actor_id est null pour les actions déclenchées par le système (cron d'expiration).
model OrderActivity {
  activity_id String   @id @default(uuid())
  order_id    String
  action      String   // EN_PREPARATION|PRETE|RETIREE|ANNULEE|EXPIREE
  actor_id    String?
  created_at  DateTime @default(now())

  order       Order    @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  actor       User?    @relation(fields: [actor_id], references: [user_id])

  @@index([order_id, created_at])
}

// Historique des notifications reçues, alimentant le centre in-app (cloche).
// Un seul destinataire renseigné : customer_id (B2C) ou user_id (préparateur).
model Notification {
  notification_id String    @id @default(uuid())
  customer_id     String?
  user_id         String?
  type            String    // ORDER_CONFIRMED|ORDER_READY|ORDER_CANCELLED|NEW_ORDER_FOR_PREP
  title           String
  body            String
  data            Json?
  read_at         DateTime?
  created_at      DateTime  @default(now())

  customer        Customer? @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  user            User?     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([customer_id, created_at])
  @@index([user_id, created_at])
}

model DonParametres {
  id                   String   @id @default(uuid())
  pharmacy_id          String   @unique
  seuil_dormance_jours Int      @default(90)
  rayon_matching_km    Int      @default(50)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  pharmacy             Pharmacy @relation(fields: [pharmacy_id], references: [pharmacy_id])
}
