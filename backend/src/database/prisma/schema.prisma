generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pharmacy {
  pharmacy_id       String    @id @default(uuid())
  name              String
  email             String    @unique
  address           String?
  siret             String?
  status            String    @default("ACTIVE")
  created_at        DateTime  @default(now())
  last_upload_at    DateTime?
  subscription_tier String    @default("free")

  products          Product[]
  sales             Sale[]
  analyses          RiskAnalysis[]
  users             User[]
  actions           Action[]
  donations         Donation[]
}

model User {
  user_id           String    @id @default(uuid())
  pharmacy_id       String
  email             String    @unique
  password          String?
  role              String    @default("TITULAIRE")
  status            String    @default("ACTIVE")
  first_name        String?
  last_name         String?
  phone             String?
  accepted_terms_at DateTime?
  created_at        DateTime  @default(now())

  pharmacy    Pharmacy    @relation(fields: [pharmacy_id], references: [pharmacy_id])
  auth_tokens AuthToken[]
}

model AuthToken {
  id          String    @id @default(uuid())
  user_id     String
  token_hash  String    @unique
  type        String
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [user_id])

  @@index([token_hash])
}

model Product {
  product_id     String   @id @default(uuid())
  pharmacy_id    String
  external_sku   String
  lot_number     String?
  name           String
  category       String?
  brand          String?
  expiry_date    DateTime?
  stock_quantity Int
  unit_price     Float
  cost_price     Float?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  pharmacy       Pharmacy      @relation(fields: [pharmacy_id], references: [pharmacy_id])
  sales          Sale[]
  analyses       RiskAnalysis[]
  action         Action?
  donations      Donation[]

  @@unique([pharmacy_id, external_sku])
  @@index([pharmacy_id, expiry_date])
}

model Sale {
  sale_id         String   @id @default(uuid())
  product_id      String
  pharmacy_id     String
  sale_date       DateTime
  quantity_sold   Int
  unit_price_sold Float?
  created_at      DateTime @default(now())

  product         Product  @relation(fields: [product_id], references: [product_id])
  pharmacy        Pharmacy @relation(fields: [pharmacy_id], references: [pharmacy_id])

  @@unique([product_id, sale_date, quantity_sold])
  @@index([product_id, sale_date])
}

model RiskAnalysis {
  analysis_id        String   @id @default(uuid())
  product_id         String
  pharmacy_id        String
  analysis_date      DateTime @default(now())

  days_of_cover      Float
  sales_velocity_30d Float
  capital_locked     Float
  risk_level         String
  suggested_action   String
  recoverable_value  Float
  potential_loss     Float

  product            Product  @relation(fields: [product_id], references: [product_id])
  pharmacy           Pharmacy @relation(fields: [pharmacy_id], references: [pharmacy_id])

  @@unique([product_id, analysis_date])
}

// Centre d'actions : une action de remédiation par produit dormant
model Action {
  action_id         String    @id @default(uuid())
  product_id        String    @unique
  pharmacy_id       String
  type              String    // 'B2C' | 'DON'
  status            String    @default("EN_ATTENTE") // EN_ATTENTE|VALIDEE|IGNOREE|SNOOZEE
  snooze_until      DateTime?
  days_of_cover     Float
  capital_locked    Float
  recoverable_value Float
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  product           Product   @relation(fields: [product_id], references: [product_id])
  pharmacy          Pharmacy  @relation(fields: [pharmacy_id], references: [pharmacy_id])
  donations         Donation[]

  @@index([pharmacy_id, status])
}

// Associations bénéficiaires de dons médicamenteux
model Association {
  association_id String   @id @default(uuid())
  name           String
  address        String
  city           String
  postal_code    String
  lat            Float?
  lng            Float?
  categories     String[]
  contact_email  String?
  contact_phone  String?
  active         Boolean  @default(true)
  created_at     DateTime @default(now())

  donations      Donation[]
}

// Don médicamenteux : machine à états PROPOSEE→ACCEPTEE→RETIREE|REFUSEE
model Donation {
  donation_id     String    @id @default(uuid())
  product_id      String
  pharmacy_id     String
  association_id  String
  action_id       String?
  quantity        Int
  status          String    @default("PROPOSEE") // PROPOSEE|ACCEPTEE|RETIREE|REFUSEE
  estimated_value Float
  cerfa_number    String?
  cerfa_pdf_url   String?
  proposed_at     DateTime  @default(now())
  accepted_at     DateTime?
  withdrawn_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  product         Product     @relation(fields: [product_id], references: [product_id])
  pharmacy        Pharmacy    @relation(fields: [pharmacy_id], references: [pharmacy_id])
  association     Association @relation(fields: [association_id], references: [association_id])
  action          Action?     @relation(fields: [action_id], references: [action_id])

  @@index([pharmacy_id, status])
}
