generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pharmacy {
  pharmacy_id       String    @id @default(uuid())
  name              String
  email             String    @unique
  address           String?
  siret             String?
  created_at        DateTime  @default(now())
  last_upload_at    DateTime?
  subscription_tier String    @default("free")

  products          Product[]
  sales             Sale[]
  analyses          RiskAnalysis[]
  users             User[]
}

model User {
  user_id           String    @id @default(uuid())
  pharmacy_id       String
  email             String    @unique
  password          String?
  role              String    @default("TITULAIRE")
  status            String    @default("ACTIVE")
  first_name        String?
  last_name         String?
  phone             String?
  accepted_terms_at DateTime?
  created_at        DateTime  @default(now())

  pharmacy    Pharmacy    @relation(fields: [pharmacy_id], references: [pharmacy_id])
  auth_tokens AuthToken[]
}

model AuthToken {
  id          String    @id @default(uuid())
  user_id     String
  token_hash  String    @unique
  type        String
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [user_id])

  @@index([token_hash])
}

model Product {
  product_id     String   @id @default(uuid())
  pharmacy_id    String
  external_sku   String
  lot_number     String?
  name           String
  category       String?
  brand          String?
  expiry_date    DateTime
  stock_quantity Int
  unit_price     Float
  cost_price     Float?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  pharmacy       Pharmacy      @relation(fields: [pharmacy_id], references: [pharmacy_id])
  sales          Sale[]
  analyses       RiskAnalysis[]

  @@unique([pharmacy_id, external_sku])
  @@index([pharmacy_id, expiry_date])
}

model Sale {
  sale_id         String   @id @default(uuid())
  product_id      String
  pharmacy_id     String
  sale_date       DateTime
  quantity_sold   Int
  unit_price_sold Float?
  created_at      DateTime @default(now())

  product         Product  @relation(fields: [product_id], references: [product_id])
  pharmacy        Pharmacy @relation(fields: [pharmacy_id], references: [pharmacy_id])

  @@unique([product_id, sale_date, quantity_sold])
  @@index([product_id, sale_date])
}

model RiskAnalysis {
  analysis_id        String   @id @default(uuid())
  product_id         String
  pharmacy_id        String
  analysis_date      DateTime @default(now())

  days_to_expiry     Int
  sales_velocity_30d Float
  expected_sales     Float
  excess_stock       Int
  risk_score         Float
  risk_level         String

  suggested_action   String
  recoverable_value  Float
  potential_loss     Float

  product            Product  @relation(fields: [product_id], references: [product_id])
  pharmacy           Pharmacy @relation(fields: [pharmacy_id], references: [pharmacy_id])

  @@unique([product_id, analysis_date])
}
